[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://scripts/shared/data/quest_def.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/shared/data/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_1"]
script = ExtResource("2_step")
target_id = &"enchanted_firefly"
count = 6
text_key = "QUEST_LESSON_ARCANE_SPARK_STEP1"

[resource]
script = ExtResource("1_quest")
