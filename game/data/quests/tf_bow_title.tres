[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://scripts/shared/data/quest_def.gd" id="1_qdef"]
[ext_resource type="Script" path="res://scripts/shared/data/quest_step.gd" id="2_qstep"]

[sub_resource type="Resource" id="step_talk"]
script = ExtResource("2_qstep")
type = 3
target_id = &"instructor_bento"
count = 1
text_key = "QUEST_TF_BOW_TITLE_STEP1"

[sub_resource type="Resource" id="step_collect"]
script = ExtResource("2_qstep")
type = 1
target_id = &"spinning_leaf"
count = 4
text_key = "QUEST_TF_BOW_TITLE_STEP2"
scale_with_titles = true

[sub_resource type="Resource" id="step_kill"]
script = ExtResource("2_qstep")
type = 0
target_id = &"prank_whirlwind"
count = 5
text_key = "QUEST_TF_BOW_TITLE_STEP3"
scale_with_titles = true

[sub_resource type="Resource" id="step_trial"]
script = ExtResource("2_qstep")
type = 4
target_id = &"prank_whirlwind"
count = 1
text_key = "QUEST_TF_BOW_TITLE_STEP4"
time_limit_sec = 90.0

[resource]
script = ExtResource("1_qdef")
id = &"tf_bow_title"
name_key = "QUEST_TF_BOW_TITLE_NAME"
