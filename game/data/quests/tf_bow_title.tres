hidden_until_eligible = false
reward_title = &"pindorama_bow_cerrado"
offer_text_key = "QUEST_TF_BOW_TITLE_OFFER"
progress_text_key = "QUEST_TF_BOW_TITLE_PROGRESS"
complete_text_key = "QUEST_TF_BOW_TITLE_COMPLETE"
option_text_key = "QUEST_TF_BOW_TITLE_OPTION"
desc_key = "QUEST_TF_BOW_TITLE_DESC"
