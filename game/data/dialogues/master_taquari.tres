[gd_resource type="Resource" script_class="DialogueDef" format=3]

[ext_resource type="Script" path="res://scripts/shared/data/dialogue_option.gd" id="1_opt"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_def.gd" id="3_dlg"]

[sub_resource type="Resource" id="opt_1"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_START_OPT0"
next_node = &"about"

[sub_resource type="Resource" id="opt_2"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_START_OPT1"
next_node = &"tip"

[sub_resource type="Resource" id="opt_3"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_START_OPT2"
action = &"close"

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_node")
id = &"start"
text_key = "DLG_MASTER_TAQUARI_START"
options = Array[ExtResource("1_opt")]([SubResource("opt_1"), SubResource("opt_2"), SubResource("opt_3")])

[sub_resource type="Resource" id="opt_4"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_ABOUT_OPT0"
next_node = &"tip"

[sub_resource type="Resource" id="opt_5"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_ABOUT_OPT1"
action = &"close"

[sub_resource type="Resource" id="node_about"]
script = ExtResource("2_node")
id = &"about"
text_key = "DLG_MASTER_TAQUARI_ABOUT"
options = Array[ExtResource("1_opt")]([SubResource("opt_4"), SubResource("opt_5")])

[sub_resource type="Resource" id="opt_6"]
script = ExtResource("1_opt")
text_key = "DLG_MASTER_TAQUARI_TIP_OPT0"
action = &"close"

[sub_resource type="Resource" id="node_tip"]
script = ExtResource("2_node")
id = &"tip"
text_key = "DLG_MASTER_TAQUARI_TIP"
options = Array[ExtResource("1_opt")]([SubResource("opt_6")])

[resource]
script = ExtResource("3_dlg")
id = &"master_taquari"
nodes = Array[ExtResource("2_node")]([SubResource("node_start"), SubResource("node_about"), SubResource("node_tip")])
