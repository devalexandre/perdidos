[gd_resource type="Resource" script_class="DialogueDef" format=3]

[ext_resource type="Script" path="res://scripts/shared/data/dialogue_option.gd" id="1_option"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_def.gd" id="3_dialogue"]

[sub_resource type="Resource" id="option_bye"]
script = ExtResource("1_option")
text_key = "DLG_CORONEL_TOBIAS_BYE"
action = &"close"

[sub_resource type="Resource" id="node_start"]
script = ExtResource("2_node")
id = &"start"
text_key = "DLG_CORONEL_TOBIAS_START"
options = Array[ExtResource("1_option")]([SubResource("option_bye")])

[resource]
script = ExtResource("3_dialogue")
id = &"coronel_tobias"
nodes = Array[ExtResource("2_node")]([SubResource("node_start")])