[gd_resource type="Resource" script_class="DialogueDef" format=3]

[ext_resource type="Script" path="res://scripts/shared/data/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_option.gd" id="2_opt"]
[ext_resource type="Script" path="res://scripts/shared/data/dialogue_def.gd" id="3_def"]

[sub_resource type="Resource" id="opt_about"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_START_OPT0"
next_node = &"about"

[sub_resource type="Resource" id="opt_tip"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_START_OPT1"
next_node = &"tip"

[sub_resource type="Resource" id="opt_close_start"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_START_OPT2"
action = &"close"

[sub_resource type="Resource" id="node_start"]
script = ExtResource("1_node")
id = &"start"
text_key = "DLG_MASTER_INHAMBU_START"
options = Array[ExtResource("2_opt")]([SubResource("opt_about"), SubResource("opt_tip"), SubResource("opt_close_start")])

[sub_resource type="Resource" id="opt_about_tip"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_ABOUT_OPT0"
next_node = &"tip"

[sub_resource type="Resource" id="opt_about_close"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_ABOUT_OPT1"
action = &"close"

[sub_resource type="Resource" id="node_about"]
script = ExtResource("1_node")
id = &"about"
text_key = "DLG_MASTER_INHAMBU_ABOUT"
options = Array[ExtResource("2_opt")]([SubResource("opt_about_tip"), SubResource("opt_about_close")])

[sub_resource type="Resource" id="opt_tip_close"]
script = ExtResource("2_opt")
text_key = "DLG_MASTER_INHAMBU_TIP_OPT0"
action = &"close"

[sub_resource type="Resource" id="node_tip"]
script = ExtResource("1_node")
id = &"tip"
text_key = "DLG_MASTER_INHAMBU_TIP"
options = Array[ExtResource("2_opt")]([SubResource("opt_tip_close")])

[resource]
script = ExtResource("3_def")
id = &"master_inhambu"
nodes = Array[ExtResource("1_node")]([SubResource("node_start"), SubResource("node_about"), SubResource("node_tip")])
