 "dialogues": {
  "master_jatoba": {
   "start": {"text": "Chegou mais um! Sou Jatobá, e aqui no Campo eu ensino a Lâmina: facão firme na mão, pé firme no chão.",
    "options": [["Que lugar é este?", "about"], ["Como se luta por aqui?", "tip"], ["Até logo, mestre.", ""]]},
   "about": {"text": "Este é o Campo de Treino dos Viajantes. Cada Mestre ergueu aqui um cantinho da sua terra, para quem chega do Outro Lado conhecer o mundo antes de escolher um caminho. O nosso cantinho é este cerrado: ipê, buriti, cupinzeiro e redemoinho arteiro.",
    "options": [["Como se luta por aqui?", "tip"], ["Entendi.", ""]]},
   "tip": {"text": "Clique no bicho e deixe o braço trabalhar: você golpeia até ele cair ou até mandar outra coisa. Redemoinho é bobo, Tatu-Pedra é casca-grossa. E olho vivo: bicho que derruba Viajante fica mais forte.",
    "options": [["Obrigado, mestre.", ""]]}
  },
  "master_candeia": {
   "start": {"text": "Boa luz, Viajante. Sou Candeia, e ensino o Arcano: a arte de acender o que ninguém vê.",
    "options": [["O que é o Arcano?", "about"], ["Tem alguma dica para mim?", "tip"], ["Até logo, mestra.", ""]]},
   "about": {"text": "O Arcano é o caminho de quem luta de longe, com faísca, gelo e chama. Não se aprende em livro: passa de mão em mão, de Mestre para aprendiz. Quem chega do Outro Lado aprende qualquer arte, se tiver paciência.",
    "options": [["Tem alguma dica para mim?", "tip"], ["Vou pensar nisso.", ""]]},
   "tip": {"text": "Repare nos vaga-lumes do brejo: guardam um pouco de luz encantada e voam em roda. E não fique perto de quem bate forte. Mago esperto é mago longe.",
    "options": [["Obrigado, mestra.", ""]]}
  },
  "master_guiomar": {
   "start": {"text": "Salve, Viajante! Sou Guiomar, da alabarda, do Reino das Mouras. Queria levar-te às nossas muralhas, mas a travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Nas nossas fontes, dizem, vivem mouras encantadas que penteiam cabelos de ouro ao luar e guardam tesouros para quem cumpre a palavra dada. Quem promete e não cumpre acha só carvão.",
    "options": [["Vou lembrar disso.", ""]]}
  },
  "master_tsubaki": {
   "start": {"text": "Seja bem-vindo. Sou Tsubaki, da naginata, das Ilhas do Sol Nascente. A travessia para a nossa terra ainda não está aberta. Por enquanto, cuide da postura.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Nos rios das ilhas vive o kappa, que guarda água num pratinho no alto da cabeça. Se ele fizer uma reverência, faça também: a água derrama e ele perde a força. Dizem que um kappa, para ser solto, ensinou a arte de pôr ossos no lugar.",
    "options": [["Que história boa.", ""]]}
  },
  "master_solveig": {
   "start": {"text": "Chegue perto do fogo, Viajante. Sou Solveig, do escudo, dos Fiordes de Gelo. A travessia para a nossa terra ainda não está aberta: o mar de lá ainda está preso no gelo.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Nos fiordes, os trolls descem das montanhas quando escurece. Os velhos contam que o sol da manhã os transforma em pedra. Por isso tanta rocha lá tem cara de gente.",
    "options": [["Vou lembrar disso.", ""]]}
  },
  "master_nicandro": {
   "start": {"text": "Salve, Viajante! Sou Nicandro, da lança e do escudo, da Costa das Colunas. A travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Lá existe um labirinto tão velho que ninguém lembra quem o construiu. Quem entra leva um novelo de linha e vai deixando o fio para trás: é o único jeito de achar a saída.",
    "options": [["Que história boa.", ""]]}
  },
  "master_seneb": {
   "start": {"text": "Que a sombra te seja fresca, Viajante. Sou Seneb, escriba e mestre do khopesh, das Areias do Nilo. A travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "No deserto há uma esfinge que guarda a passagem com enigmas. Ela não quer a tua espada: quer a tua resposta. E os nossos curadores tratam feridas com mel e linho limpo, como ensinam os papiros antigos.",
    "options": [["Vou lembrar disso.", ""]]}
  },
  "master_ewan": {
   "start": {"text": "Bem-vindo, Viajante. Sou Ewan, da espada longa e da harpa, das Brumas Verdes. A travessia para a nossa terra ainda não está aberta: a névoa ainda não deixa passar.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Nas praias de lá, as selkies tiram a pele de foca para dançar na areia ao luar. Quem esconde a pele de uma selkie ganha uma saudade que nunca acaba.",
    "options": [["Que história boa.", ""]]}
  },
  "master_zlata": {
   "start": {"text": "Saudações, Viajante. Sou Zlata, do arco e do machado, da Estepe de Ferro. A travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Na floresta de bétulas mora uma velha numa cabana com pés de galinha, que gira para a porta dar para quem chega. Seja educado e ela pode ajudar. Seja grosseiro... bem, melhor ser educado.",
    "options": [["Vou lembrar disso.", ""]]}
  },
  "master_xiaoyu": {
   "start": {"text": "Bem-vindo, Viajante. Sou Xiaoyu, da espada jian, do Império de Jade. A travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Todo fim de ano a fera Nian desce das montanhas. Mas ela tem medo do vermelho, do fogo e do barulho: por isso penduramos lanternas vermelhas e soltamos fogos. Nenhuma fera aguenta uma festa bem barulhenta.",
    "options": [["Que história boa.", ""]]}
  },
  "master_citlali": {
   "start": {"text": "Bem-vindo, Viajante. Sou Citlali, da lâmina de obsidiana, das Selvas de Obsidiana. A travessia para a nossa terra ainda não está aberta.",
    "options": [["Conte sobre a sua terra.", "lore"], ["Até logo.", ""]]},
   "lore": {"text": "Nas nossas selvas, abelhas sem ferrão fazem um mel que cura, e o jaguar anda sem fazer barulho. Quem entra na mata pede licença e cuida do caminho: a selva lembra de quem a respeita.",
    "options": [["Vou lembrar disso.", ""]]}
  }
 }
}
